[Unit]
Description=NetSentinel IP Monitoring Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/netsentinel
ExecStart=/usr/bin/node /opt/netsentinel/dist/server.cjs
Restart=always
RestartSec=5
Environment=NODE_ENV=production PORT=3000

[Install]
WantedBy=multi-user.target
